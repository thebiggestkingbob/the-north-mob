# Use a verified canonical HTTPS domain only when ready to publish.
SITE_URL=
# Owner-controlled HTTPS email-delivery adapter. Server-only; never NEXT_PUBLIC.
# POST payload: {name,email,type,message,consent}; Authorization: Bearer TOKEN.
# Adapter must return HTTP 2xx and {"delivered":true} after confirmed delivery.
CONTACT_DELIVERY_URL=
CONTACT_DELIVERY_TOKEN=
# Optional rights-cleared original video hosted on a CDN. Never download social videos.
NATIVE_VIDEO_URL=
NATIVE_VIDEO_CAPTIONS_URL=
